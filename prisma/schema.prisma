generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A guest with a Unity Parks account. Email is always stored lowercase -
// SQLite has no case-insensitive filter, so normalize-on-write is what makes
// every email comparison in the app correct.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email        String @unique // always lowercase
  passwordHash String // "saltHex:hashHex" from node:crypto scrypt
  firstName    String
  lastName     String
  phone        String?

  authSessions    AuthSession[]
  bookingSessions BookingSession[]
  bookingRecords  BookingRecord[]
}

// A login session. The row id IS the bearer token carried by the up_session
// cookie (256 random bits). Fixed expiry, no sliding refresh, so reads never
// write. Not to be confused with BookingSession, the shopping funnel state.
model AuthSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per guest walking the funnel: everything captured between search
// and payment, so any step can be refreshed or revisited without loss.
// Prices are snapshots of what Apaleo returned, never computed locally.
model BookingSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  state     String   @default("selecting") // selecting | checkout | completed | expired

  // Who was signed in when this funnel walk happened. Stamped at creation
  // (and refreshed on details submit), copied onto the BookingRecord at
  // checkout. Null means an anonymous guest walk - always allowed.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Stay: ISO dates (YYYY-MM-DD), validated to land on Fri/Mon turnover days
  arrival      String
  departure    String
  adults       Int
  childrenAges String @default("[]") // JSON int array

  // Chosen lodge offer (snapshot from Apaleo offers)
  unitGroupCode   String?
  ratePlanId      String?
  stayGrossAmount Float?
  currency        String  @default("KES")

  // Chosen extras: JSON [{ serviceId, code, name, count, grossAmount }]
  extras String @default("[]")

  guests SessionGuest[]
  lodges SessionLodge[]

  // Lead guest + vehicle (for the ANPR gate story). Title and date of birth
  // are Center Parcs parity: the lead booker must be an adult at arrival.
  guestTitle       String?
  guestFirstName   String?
  guestLastName    String?
  guestEmail       String?
  guestPhone       String?
  guestDateOfBirth String? // ISO YYYY-MM-DD
  vehiclePlate     String?

  // Marketing consent, captured with the details form like Center Parcs.
  marketingEmail Boolean @default(false)
  marketingSms   Boolean @default(false)

  booking BookingRecord?
}

// One lodge in a break: its slot, its own party, its chosen tier snapshot,
// its extras, and (after checkout) its Apaleo reservation. A single-lodge
// booking is simply the N=1 case; the funnel loops where it used to assume
// one lodge. During the multi-lodge transition the legacy single-lodge
// columns on BookingSession stay populated as a mirror of slot 0.
model SessionLodge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   BookingSession @relation(fields: [sessionId], references: [id])
  slot      Int // 0-based: Lodge 1, Lodge 2, Lodge 3

  // This lodge's own party
  adults       Int
  childrenAges String @default("[]") // JSON int array

  // Chosen tier (snapshot from Apaleo offers); null until selected
  unitGroupCode   String?
  ratePlanId      String?
  stayGrossAmount Float?

  // This lodge's extras: JSON [{ serviceId, code, name, count, grossAmount }]
  extras String @default("[]")

  // Set at checkout, when Apaleo returns one reservation per lodge
  apaleoReservationId String?

  @@unique([sessionId, slot])
}

// The guest manifest, Center Parcs parity: every guest named, children's
// dates of birth, stored only in our DB - Apaleo never needs more than
// counts and ages. One row per party member with a stable position per
// session, so edits (and the future invite-a-guest link) never lose rows.
model SessionGuest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   BookingSession @relation(fields: [sessionId], references: [id])
  slot      Int @default(0) // which lodge this guest stays in
  position  Int // 0 = lead adult; order fixed by the booked party shape
  band      String // adult | child | toddler | infant, derived from the party
  isLead    Boolean @default(false)

  firstName   String?
  lastName    String?
  dateOfBirth String? // ISO YYYY-MM-DD, expected for non-adults
  email       String? // lowercase; the invite-a-guest seam, unused today
  invitedUserId String? // always null today; filled when invites ship

  @@unique([sessionId, slot, position])
}

// Written once the booking exists in Apaleo. `status` flips to paid only
// after the folio payment is confirmed; the confirmation page reads this,
// never a redirect.
model BookingRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId String         @unique
  session   BookingSession @relation(fields: [sessionId], references: [id])

  apaleoBookingId     String
  apaleoReservationId String
  folioId             String?

  totalGrossAmount Float // demo: JS number is fine; production would use integer minor units
  currency         String

  status    String    @default("created") // created | paid | failed
  paidAt    DateTime?
  paymentId String? // Apaleo payment id returned by the folio post

  // Ownership. Copied from the session at creation, or adopted later by the
  // claim backfill when an account registers/logs in with the guest email.
  // claimedVia records how the link happened so a wrong adoption is visible
  // and hand-reversible.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  claimedAt  DateTime?
  claimedVia String? // "email-match" when adopted by the claim backfill

  reservations BookingReservation[]
  pesapalTransactions PesapalTransaction[]
}

// One Pesapal order per payment attempt for a booking (the guest sees one
// charge even for a multi-lodge break; the per-folio split is recorded on
// Apaleo at settle time). The row id doubles as the merchant reference sent
// to Pesapal, so a lookup can start from either end. Pesapal requires a
// fresh merchant reference per attempt, hence one row per attempt.
model PesapalTransaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordId String
  record   BookingRecord @relation(fields: [recordId], references: [id])

  // What we asked Pesapal to collect, snapshot at submit time. Checked
  // against Pesapal's word before any folio write-back.
  amount   Float
  currency String

  // Pesapal's id and hosted-page URL, set once SubmitOrderRequest succeeds.
  // The URL is kept so a pending attempt can be re-entered without creating
  // a duplicate order (the shared sandbox merchant rate-limits submissions).
  orderTrackingId String? @unique
  redirectUrl     String?

  // pending | completed | failed | superseded, plus three flags a human must
  // act on: mismatch (Pesapal's amount differs from ours), excess (a second
  // order for an already-paid booking was collected), reversed (chargeback
  // after settlement).
  status           String  @default("pending")
  confirmationCode String? // Pesapal's processor confirmation, for reconciliation
  paymentMethod    String? // e.g. Visa, MpesaKE, as reported by GetTransactionStatus

  // The serializer: holds the record id while this row is the one live
  // attempt (pending, or completed but not yet settled); cleared when the
  // row retires. The unique constraint turns two concurrent Buy nows into a
  // plain constraint violation instead of two payable Pesapal orders.
  liveForRecordId String? @unique
}

// Payment state per reservation (one row per lodge in the booking): a crash
// between folio payments must resume by settling only what is still owed,
// never re-paying and never giving up. The legacy singular columns on
// BookingRecord remain for rows born before multi-lodge; children are the
// source of truth once backfilled.
model BookingReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recordId String
  record   BookingRecord @relation(fields: [recordId], references: [id])
  slot     Int

  apaleoReservationId String
  folioId             String?
  grossAmount         Float
  currency            String
  paymentId           String?
  paidAt              DateTime?

  @@unique([recordId, slot])
}
