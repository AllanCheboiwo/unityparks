generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A guest with a Unity Parks account. Email is always stored lowercase -
// SQLite has no case-insensitive filter, so normalize-on-write is what makes
// every email comparison in the app correct.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email        String @unique // always lowercase
  passwordHash String // "saltHex:hashHex" from node:crypto scrypt
  firstName    String
  lastName     String
  phone        String?

  // The account profile, Center Parcs style: the details form prefills from
  // here for signed-in guests, and edits there write back. All nullable -
  // accounts created before these fields existed simply have gaps.
  title       String?
  dateOfBirth String? // ISO YYYY-MM-DD

  // Postal address (welcome-pack story). Stored here and on the booking
  // session snapshot only - never sent to Apaleo.
  addressLine1 String?
  addressLine2 String?
  townCity     String?
  county       String?
  postcode     String?
  country      String?

  // Durable marketing consent; the session columns keep the per-booking
  // record of what was ticked at the time.
  marketingEmail Boolean @default(false)
  marketingSms   Boolean @default(false)

  // Gates the /ops pages (referral admin). Flagged by hand via
  // scripts/make-admin.mjs; there is no in-app path to admin.
  isAdmin Boolean @default(false)

  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  bookingSessions BookingSession[]
  bookingRecords  BookingRecord[]
  referralParticipant ReferralParticipant?
}

// A login session. The row id IS the bearer token carried by the up_session
// cookie (256 random bits). Fixed expiry, no sliding refresh, so reads never
// write. Not to be confused with BookingSession, the shopping funnel state.
model AuthSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A password-reset link. Same shape as AuthSession (the row id IS the token
// in the emailed link) but short-lived and single-use: consumed rows are
// deleted, and issuing a new token deletes the user's older ones, so at
// most one reset link works at any time.
model PasswordResetToken {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per guest walking the funnel: everything captured between search
// and payment, so any step can be refreshed or revisited without loss.
// Prices are snapshots of what Apaleo returned, never computed locally.
model BookingSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  state     String   @default("selecting") // selecting | checkout | completed | expired

  // Who was signed in when this funnel walk happened. Stamped at creation
  // (and refreshed on details submit), copied onto the BookingRecord at
  // checkout. Null means an anonymous guest walk - always allowed.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Stay: ISO dates (YYYY-MM-DD), validated to land on Fri/Mon turnover days
  arrival      String
  departure    String
  adults       Int
  childrenAges String @default("[]") // JSON int array

  // Chosen lodge offer (snapshot from Apaleo offers)
  unitGroupCode   String?
  ratePlanId      String?
  stayGrossAmount Float?
  currency        String  @default("KES")

  // Chosen extras: JSON [{ serviceId, code, name, count, grossAmount }]
  extras String @default("[]")

  guests SessionGuest[]
  lodges SessionLodge[]

  // Lead guest + vehicle (for the ANPR gate story). Title and date of birth
  // are Center Parcs parity: the lead booker must be an adult at arrival.
  guestTitle       String?
  guestFirstName   String?
  guestLastName    String?
  guestEmail       String?
  guestPhone       String?
  guestDateOfBirth String? // ISO YYYY-MM-DD
  // One entry per car (JSON string array), each the plate or "" for "don't
  // know the registration"; "[]" means no car. Captured on the Guest Details
  // step, Center Parcs style.
  vehiclePlates    String  @default("[]")

  // Lead booker's postal address, snapshotted per booking (welcome-pack
  // story). Local only - never sent to Apaleo.
  guestAddressLine1 String?
  guestAddressLine2 String?
  guestTownCity     String?
  guestCounty       String?
  guestPostcode     String?
  guestCountry      String?

  // Marketing consent, captured with the details form like Center Parcs.
  marketingEmail Boolean @default(false)
  marketingSms   Boolean @default(false)

  // Referral capture. The code is stamped from the up_ref cookie at session
  // creation and editable at the details step until a BookingRecord exists,
  // after which both fields are frozen (the folio totals are frozen too, so
  // a late code change could never be honoured). referralDiscount is the
  // advisory display snapshot; ensureRecord recomputes from config.
  referralCode     String?
  referralDiscount Float?

  // Credit redemption choice, stamped by POST /api/session/[id]/credit from
  // the pay step. Advisory like everything else on the session: ensureRecord
  // re-derives the spendable balance authoritatively and clamps.
  applyCredit  Boolean @default(false)
  creditAmount Float?

  booking BookingRecord?
  creditSpend ReferralLedgerEntry?
}

// One lodge in a break: its slot, its own party, its chosen tier snapshot,
// its extras, and (after checkout) its Apaleo reservation. A single-lodge
// booking is simply the N=1 case; the funnel loops where it used to assume
// one lodge. During the multi-lodge transition the legacy single-lodge
// columns on BookingSession stay populated as a mirror of slot 0.
model SessionLodge {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   BookingSession @relation(fields: [sessionId], references: [id])
  slot      Int // 0-based: Lodge 1, Lodge 2, Lodge 3

  // This lodge's own party
  adults       Int
  childrenAges String @default("[]") // JSON int array

  // Chosen tier (snapshot from Apaleo offers); null until selected
  unitGroupCode   String?
  ratePlanId      String?
  stayGrossAmount Float?

  // This lodge's extras: JSON [{ serviceId, code, name, count, grossAmount }]
  extras String @default("[]")

  // Location step: the guest's request. "unit" means a specific lodge picked
  // for a fee, "none" means no preference (free), null means the step has not
  // been completed yet. The fee is an Apaleo service-offer snapshot, never a
  // locally invented number; the service itself is attached at checkout.
  locationChoice    String?
  locationUnitId    String? // Apaleo unit id, e.g. UPNV-EBP
  locationUnitName  String? // display name, e.g. "Fig Lane 3" (old rows keep their pre-rename snapshots)
  locationServiceId String? // fee service to attach at checkout (UPNV-LOCATION)
  locationFee       Float?

  // Set at checkout, when Apaleo returns one reservation per lodge
  apaleoReservationId String?

  @@unique([sessionId, slot])
}

// The guest manifest, Center Parcs parity: every guest named, children's
// dates of birth, stored only in our DB - Apaleo never needs more than
// counts and ages. One row per party member with a stable position per
// session, so edits (and the future invite-a-guest link) never lose rows.
model SessionGuest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   BookingSession @relation(fields: [sessionId], references: [id])
  slot      Int @default(0) // which lodge this guest stays in
  position  Int // 0 = lead adult; order fixed by the booked party shape
  band      String // adult | child | toddler | infant, derived from the party
  isLead    Boolean @default(false)

  firstName   String?
  lastName    String?
  dateOfBirth String? // ISO YYYY-MM-DD, expected for non-adults
  email       String? // lowercase; the invite-a-guest seam, unused today
  invitedUserId String? // always null today; filled when invites ship

  @@unique([sessionId, slot, position])
}

// Written once the booking exists in Apaleo. `status` flips to paid only
// after the folio payment is confirmed; the confirmation page reads this,
// never a redirect.
model BookingRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId String         @unique
  session   BookingSession @relation(fields: [sessionId], references: [id])

  apaleoBookingId     String
  apaleoReservationId String
  folioId             String?

  totalGrossAmount Float // demo: JS number is fine; production would use integer minor units
  currency         String

  // Payment plan. Set at record creation for every new booking: the deposit
  // is 30% of the total and the balance falls due 56 days before arrival,
  // whether or not the guest used the deposit option. Null on records from
  // before the feature; readers fall back to computing 30% on the fly.
  depositAmount  Float?
  balanceDueDate String? // ISO YYYY-MM-DD, arrival minus 56 days

  // Sum of the children's paidAmount, derived from folio balances at settle
  // time. 0 on legacy rows; a legacy "paid" record is read as fully paid.
  paidAmount Float @default(0)

  status    String    @default("created") // created | deposit_paid | paid | failed | cancelled
  paidAt    DateTime?
  paymentId String? // Apaleo payment id returned by the folio post

  // When the booking-confirmation email was handed to Resend. Claimed
  // atomically before sending so the callback/IPN settle race can never
  // produce two emails; null means not sent (or a failed attempt was
  // released for a later retry).
  confirmationEmailAt DateTime?

  // Cancellation outcome. refundAmount is what our tier policy refunded
  // across every folio (0 for a no-refund window); the emailed-once stamp
  // works exactly like confirmationEmailAt.
  cancelledAt         DateTime?
  refundAmount        Float?
  cancellationEmailAt DateTime?

  // Balance reminder stamps (deposit plan phase 2), one per reminder stage,
  // claimed atomically like every other email stamp. Each stage sends at
  // most once in a booking's life; there is still no scheduler, the ops
  // reminders route walks candidates whenever it is run.
  reminderUpcomingEmailAt DateTime?
  reminderOverdueEmailAt  DateTime?

  // Ownership. Copied from the session at creation, or adopted later by the
  // claim backfill when an account registers/logs in with the guest email.
  // claimedVia records how the link happened so a wrong adoption is visible
  // and hand-reversible.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  claimedAt  DateTime?
  claimedVia String? // "email-match" when adopted by the claim backfill

  reservations BookingReservation[]
  pesapalTransactions PesapalTransaction[]
  referralAttribution ReferralAttribution?
  extrasOrders        ExtrasOrder[]
}

// One "add extras after booking" operation for one lodge, created BEFORE any
// Apaleo write so a crash mid-operation always leaves a row to recover from.
// The verified book-service semantics make recovery exact: booking a service
// sets its count absolutely (2 bikes then count 3 = 3 bikes, not 5), so
// writing previousCount back is a clean rollback and writing targetCount
// again is a clean retry.
model ExtrasOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordId String
  record   BookingRecord @relation(fields: [recordId], references: [id])
  slot     Int

  // JSON [{ serviceId, code, name, pricingUnit, previousCount, addCount,
  //         targetCount, amount }] - counts are absolute before/after values
  // for book-service, amount is the quoted price for the added quantity.
  additions String

  // What the guest approved (sum of addition amounts). The folio delta must
  // match within a whole KES or the whole order rolls back.
  expectedDelta Float
  // The folio delta actually observed; equals expectedDelta on the happy path.
  chargedDelta  Float?
  currency      String

  // "charge_now": paid bookings settle the new charge on the folio at once,
  // amend-style. "on_balance": deposit-paid bookings fold it into the
  // outstanding balance and the existing pay route collects it later.
  kind String

  status String @default("created") // created | settled | failed

  // Once-only stamp for the extras receipt email, same claim-release
  // discipline as BookingRecord.confirmationEmailAt.
  emailAt DateTime?

  // The serializer, exactly like PesapalTransaction: holds the record id
  // while this order is live, cleared when it settles or fails, so two
  // concurrent adds become a constraint violation instead of a double booking.
  liveForRecordId String? @unique
}

// One Pesapal order per payment attempt for a booking (the guest sees one
// charge even for a multi-lodge break; the per-folio split is recorded on
// Apaleo at settle time). The row id doubles as the merchant reference sent
// to Pesapal, so a lookup can start from either end. Pesapal requires a
// fresh merchant reference per attempt, hence one row per attempt.
model PesapalTransaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordId String
  record   BookingRecord @relation(fields: [recordId], references: [id])

  // What we asked Pesapal to collect, snapshot at submit time. Checked
  // against Pesapal's word before any folio write-back.
  amount   Float
  currency String

  // Pesapal's id and hosted-page URL, set once SubmitOrderRequest succeeds.
  // The URL is kept so a pending attempt can be re-entered without creating
  // a duplicate order (the shared sandbox merchant rate-limits submissions).
  orderTrackingId String? @unique
  redirectUrl     String?

  // What this payment is for: "checkout" (the Buy-now payment, deposit or
  // full) or "balance" (a later top-up from Manage my booking). Decides the
  // callback redirect and which email the settle sends.
  kind String @default("checkout")

  // Once-only stamp for the balance-payment receipt email, same discipline
  // as BookingRecord.confirmationEmailAt.
  receiptEmailAt DateTime?

  // pending | completed | failed | superseded, plus three flags a human must
  // act on: mismatch (Pesapal's amount differs from ours), excess (a second
  // order for an already-paid booking was collected), reversed (chargeback
  // after settlement).
  status           String  @default("pending")
  confirmationCode String? // Pesapal's processor confirmation, for reconciliation
  paymentMethod    String? // e.g. Visa, MpesaKE, as reported by GetTransactionStatus

  // The serializer: holds the record id while this row is the one live
  // attempt (pending, or completed but not yet settled); cleared when the
  // row retires. The unique constraint turns two concurrent Buy nows into a
  // plain constraint violation instead of two payable Pesapal orders.
  liveForRecordId String? @unique
}

// Payment state per reservation (one row per lodge in the booking): a crash
// between folio payments must resume by settling only what is still owed,
// never re-paying and never giving up. The legacy singular columns on
// BookingRecord remain for rows born before multi-lodge; children are the
// source of truth once backfilled.
model BookingReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recordId String
  record   BookingRecord @relation(fields: [recordId], references: [id])
  slot     Int

  apaleoReservationId String
  folioId             String?
  grossAmount         Float
  currency            String
  paymentId           String?
  // Money recorded on this folio so far, derived (grossAmount minus the
  // folio balance) after each settle. paidAt stays "fully paid" only.
  paidAmount          Float     @default(0)
  paidAt              DateTime?

  // Location step outcome, written when the reservation is created. The unit
  // Apaleo actually assigned, and whether the guest's chosen unit was lost to
  // a concurrent booking (Center Parcs policy: comparable unit auto-assigned,
  // fee removed before the payment amount was fixed).
  assignedUnitId     String?
  assignedUnitName   String?
  locationFeeDropped Boolean @default(false)

  @@unique([recordId, slot])
}

// A footer newsletter sign-up: the cheapest real version of the feature.
// Lowercase unique email and nothing else; stored here for a later export
// to whatever marketing provider gets chosen, never sent anywhere today.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique // always lowercase
}

// ---------------------------------------------------------------------------
// Referral engine (docs/referral-system-plan.md). Two tracks: influencers
// earn cash commission, clients earn resort credit. The PMS knows nothing
// about referrals; the discount reaches Apaleo as a folio allowance posted
// inside ensureRecord before the folio balances are read and frozen.
// ---------------------------------------------------------------------------

// A person who can refer: an influencer we onboarded or a client who claimed
// their code. The code is permanent and identifies the person, nothing else;
// amounts live in ReferralConfig rows.
model ReferralParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  kind  String // "influencer" | "client" (room for "family", "organizer" later)
  name  String
  email String? // lowercase via normalizeEmail; self-use checks compare against this
  phone String?

  // 5-7 chars from an alphabet without 0/O/1/I, stored uppercase. Vanity
  // codes for influencers. Never reissued: revoking means revoking the
  // person, and rows are never deleted.
  code String @unique

  // Influencers only. Null on an influencer means the config default in
  // force at each booking applies; always null for clients.
  commissionRate Float?

  // Client participants link to their account. Influencers have no account
  // at launch (no dashboard; their window is email plus the payout note).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  revokedAt DateTime?

  attributions ReferralAttribution[]
  ledger       ReferralLedgerEntry[]
}

// Dated program parameters, append-only: to change an amount, insert a new
// row with a later effectiveFrom. "In force" means the latest row whose
// effectiveFrom is on or before the UTC date ensureRecord runs (never the
// stay dates). Amounts are frozen into the attribution at booking, so
// config changes never rewrite history.
model ReferralConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  effectiveFrom         String // ISO date
  guestDiscount         Float // whole KES off the referred booking, once per booking
  clientCredit          Float // whole KES credit for a client referrer
  defaultCommissionRate Float // used when an influencer's own rate is null
  creditExpiryDays      Int // client credit only; commissions never expire

  attributions ReferralAttribution[]
}

// One referred booking. Created inside the same nested create as the
// BookingRecord, so it exists exactly when the record exists (the P2002
// adopt-the-winner race in ensureRecord makes any later write unsafe).
// All amounts are frozen here; discountAmount is what was actually posted
// to the folios, which the cap rule can make smaller than the configured
// figure.
model ReferralAttribution {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  recordId String        @unique
  record   BookingRecord @relation(fields: [recordId], references: [id])

  participantId String
  participant   ReferralParticipant @relation(fields: [participantId], references: [id])

  configId String
  config   ReferralConfig @relation(fields: [configId], references: [id])

  discountAmount Float // posted to the folio(s), not the configured number
  rewardAmount   Float // frozen: clientCredit, or rate * commissionBase
  commissionBase Float? // influencer only: lodging gross minus discount, floored at 0

  // Owner booked for someone else while signed in: discount yes, reward no.
  gift Boolean @default(false)

  // booked | earned | void. Once-only guards and ops display; money
  // predicates never trust state alone, they join record.status too, so a
  // crashed state write self-heals at read.
  state    String    @default("booked")
  earnedAt DateTime?
  voidedAt DateTime?

  // JSON array of per-folio Apaleo allowance ids, for reconciliation.
  allowanceRefs String @default("[]")

  // Once-only stamp for the referrer's "reward on the way" email, same
  // claim-release discipline as BookingRecord.confirmationEmailAt.
  rewardEmailAt DateTime?

  ledger ReferralLedgerEntry[]
}

// Append-only value ledger. Every amount is SIGNED whole KES: earns and
// releases positive, spends and payouts negative. Every derived figure
// (vested balance, payout due) is a plain SUM(amount) over a filtered set
// of rows. No row is ever updated or deleted, and no balance is ever a
// stored column.
model ReferralLedgerEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  participantId String
  participant   ReferralParticipant @relation(fields: [participantId], references: [id])

  // Earns point at their attribution. Spend, payout, and release rows keep
  // this null; Postgres treats nulls as distinct in unique indexes, so they
  // never collide on the earn constraint below, and they must stay null.
  attributionId String?
  attribution   ReferralAttribution? @relation(fields: [attributionId], references: [id])

  kind   String // credit_earn | credit_spend | commission_earn | payout | credit_release
  amount Float // signed: earns/releases positive, spends/payouts negative

  // credit_spend: the BookingSession the redemption rode (one spend per
  // session, ever; the record does not exist yet when the spend is claimed,
  // and BookingRecord.sessionId is unique so the session names the record).
  spentOnSessionId String?         @unique
  spentOnSession   BookingSession? @relation(fields: [spentOnSessionId], references: [id])

  // credit_release: the locked spend this ops action unlocks (one per
  // spend, ever). See the locked-credit edge in the plan, section 6.3.
  releaseOfEntryId String? @unique

  // The credit_spend lifecycle, carried ON the spend row so that releasing
  // a claim and committing it to a folio are guarded writes to the SAME
  // row: the database serializes them and the loser's guard simply fails.
  // (A release stored only as a separate paired row let both sides decide
  // independently, which double-counted credit. Plan 6.3.)
  // releasedAt: the claim was given back to the pool (self-service before a
  // record exists, or an ops release); the paired credit_release row stays
  // as the ledger's value entry.
  releasedAt DateTime?
  // postingStartedAt: checkout committed this claim to a folio allowance.
  // Once set, no release may happen: the money is on the bill.
  postingStartedAt DateTime?

  // payout rows: deterministic batch id, e.g. "2026-09-influencers", so a
  // re-run of a payout batch cannot double-pay.
  payoutBatchId String?

  // One earn of each kind per attribution, ever.
  @@unique([attributionId, kind])
  // One payout per influencer per batch, ever: the DB-level half of the
  // deterministic-batch discipline (a re-run is a constraint violation,
  // not a second payment).
  @@unique([participantId, payoutBatchId])
  // Keeps the Serializable spend-claim transaction's predicate locks to one
  // participant's rows instead of the whole relation, so two guests
  // redeeming at once never abort each other.
  @@index([participantId])
}
